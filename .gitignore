/target
**/*.rs.bk
*.swp
.DS_Store
__pycache__/
*.pyc
.venv/
/data/raw/
/data/processed/
/data/cache/
/data/external/
/benchmarks/jevbench/data/
/reports/raw/*.jsonl
!/reports/raw/.gitkeep
/node_modules/
.env
.env.*

# Benchmark harness checkouts, datasets and virtualenv (fetched by benchmarks/*/fetch.sh)
/benchmarks/jevbench/harness/
/benchmarks/jev_bench_hf/data/
/benchmarks/jev_bench_hf/harness/
/benchmarks/.venv/
# Raw per-item responses of benchmark runs (large; the summaries are kept)
reports/**/raw/

# large raw benchmark outputs are kept gzipped
reports/jev_bench_hf/*/preds.jsonl
reports/leakage_prescan.json

/experiments/runs/*/
!/experiments/runs/*/config.json
!/experiments/runs/*/metrics.json
/data/bench_internal/*.jsonl
/data/neural/
/models/

# Synthetic training pool built by scripts/synth/bench/build.py (large).
# Regenerate with: python3 scripts/synth/bench/build.py --seed 20260923
# data/bench_internal/*.jsonl is already ignored above; MANIFEST.json is committed.
!/data/bench_internal/MANIFEST.json
/data/synthetic/bench_train.jsonl
# Extended long-context training split (123 MB).
# Regenerate with: python3 scripts/synth/bench/build.py --long-train-only
/data/synthetic/bench_train_lc.jsonl

# Per-candidate probe dumps from challenger evaluation (large; summaries kept)
reports/challengers/*.calib_probe.jsonl

# Exported retrieval features for fitting the learned ranker (large).
# Regenerate with: sextant export-retrieval ... (see docs/NEURAL.md)
/data/retrieval/
